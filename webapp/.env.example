NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Shared secret required to trigger /api/ingest/* routes.
INGEST_SECRET=

# Contact email for CrossRef's "polite pool" rate limits.
CROSSREF_MAILTO=

# Resend.com API key for sending saved-search email digests.
RESEND_API_KEY=
# Sender address for digest emails. Resend's sandbox address
# (onboarding@resend.dev) only delivers to the account owner's own email
# until a custom domain is verified — see task notes.
DIGEST_FROM_EMAIL=

# Upstash Redis (free tier) — used for site-wide rate limiting in the proxy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
